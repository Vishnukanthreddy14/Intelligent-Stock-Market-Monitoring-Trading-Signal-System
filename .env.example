# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stock_ticks
KAFKA_NUM_PARTITIONS=5
KAFKA_CONSUMER_GROUP=stock_analytics_group

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stock_analytics
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password

# Market Data Collection Configuration
COLLECTION_INTERVAL_SECONDS=5
EXCHANGE=NSE

# Target Symbols to Partition Mapping
# Partition 0 -> ICICIBANK
# Partition 1 -> SBIN
# Partition 2 -> HDFCBANK
# Partition 3 -> INFY
# Partition 4 -> TCS
TARGET_STOCKS=ICICIBANK,SBIN,HDFCBANK,INFY,TCS
